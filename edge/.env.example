# ── Core Edge Configuration ────────────────────────────

# Control plane API endpoint (Required)
VEIL_CONTROL_PLANE_URL=http://localhost:5000

# Shared secret for authenticating with the control plane (Required)
VEIL_NODE_TOKEN=dev-secret-token

# Listener addresses
VEIL_LISTEN_HTTP=127.0.0.1:8080
# VEIL_LISTEN_HTTPS=0.0.0.0:443

# Local JSON config path (Fallback/development mode config without control plane)
VEIL_CONFIG_PATH=veil.json


# ── Challenge & Security ───────────────────────────────

# Proof-of-Work Difficulty (Default: 20 leading zero bits)
# At 20, modern browsers solve in ~50ms via WASM.
VEIL_POW_DIFFICULTY=20

# The name of the cookie issued after successful challenge validation
VEIL_CHALLENGE_COOKIE=veil_pass

# Time-To-Live for the challenge pass cookie in seconds (Default: 600)
VEIL_CHALLENGE_TTL=600

# HMAC-SHA256 signing key (Must be exactly 32 bytes encoded in 64 hex characters)
# If not provided, a random key is generated on startup (tokens won't survive restarts)
VEIL_HMAC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff


# ── External Dependencies ──────────────────────────────

# Redis connection string for distributed rate limiting and state
# VEIL_REDIS_URL=redis://127.0.0.1:6379

# Path to the MaxMind GeoLite2 City database for geo-blocking
# VEIL_GEOIP_PATH=./data/GeoLite2-City.mmdb


# ── Observability & Performance ────────────────────────

# Log level (trace, debug, info, warn, error)
VEIL_LOG_LEVEL=debug

# Analytics worker endpoint for batched request log forwarding
# VEIL_LOG_SINK_URL=http://localhost:5001/ingest

# Number of async worker threads (Default: logical CPU count)
# VEIL_WORKER_THREADS=4
