# ── Core Edge Configuration ────────────────────────────

# Control plane API endpoint. Together with VEIL_NODE_ID and
# VEIL_NODE_TOKEN enables config sync; otherwise the node runs from the
# local VEIL_CONFIG_PATH file.
VEIL_CONTROL_PLANE_URL=http://localhost:5150

# This node's id, as returned by POST /v1/edge-nodes (e.g. edg_...)
VEIL_NODE_ID=

# Node token issued once at registration (vnt_...). Also authenticates
# config pushes to this node.
VEIL_NODE_TOKEN=

# Listener addresses
VEIL_LISTEN_HTTP=127.0.0.1:8080
# VEIL_LISTEN_HTTPS=0.0.0.0:443

# Local JSON config path — used ONLY when the control plane is not
# configured (development mode). Not a fallback for control plane mode.
VEIL_CONFIG_PATH=veil.json

# Last-known-good config snapshot (optional). When set, every successful
# pull/push is written here and the node can restart from it while the
# control plane is unreachable. Point it at a persistent volume in
# containerized deployments; without it, an unreachable control plane at
# startup means the node refuses to start.
# VEIL_CONFIG_CACHE=./config-cache.json


# ── Challenge & Security ───────────────────────────────

# Proof-of-Work Difficulty (Default: 20 leading zero bits)
# At 20, modern browsers solve in ~50ms via WASM.
VEIL_POW_DIFFICULTY=20

# The name of the cookie issued after successful challenge validation
VEIL_CHALLENGE_COOKIE=veil_pass

# Time-To-Live for the challenge pass cookie in seconds (Default: 600)
VEIL_CHALLENGE_TTL=600

# HMAC-SHA256 signing key (Must be exactly 32 bytes encoded in 64 hex characters)
# If not provided, a random key is generated on startup (tokens won't survive restarts)
VEIL_HMAC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Shared key verifying HMAC-signed config pushes from the ConfigSync
# worker (must match the control plane's ConfigSync:PushHmacKey).
# 64 hex chars. Unset -> only the node token authenticates pushes.
VEIL_PUSH_HMAC_KEY=8c1f36e9a2b4d5061728394a5b6c7d8e9f0a1b2c3d4e5f60718293a4b5c6d7e8

# Header carrying the push signature (must match ConfigSync:SignatureHeader)
# VEIL_PUSH_SIGNATURE_HEADER=x-veil-signature


# ── External Dependencies ──────────────────────────────

# Redis URL for FLEET-SHARED rate_limit rule counters (atomic sliding window
# via Lua). Unset -> per-process in-memory counters (correct for a single
# node only). Redis errors fail open (request allowed).
# VEIL_RATELIMIT_REDIS_URL=redis://127.0.0.1:6379

# GeoIP/ASN enrichment (optional). MaxMind MMDB files enable the `country`
# rule condition (geo-blocking) and ASN capture. Unset -> no geo enrichment.
# VEIL_GEOIP_PATH=./data/GeoLite2-Country.mmdb
# VEIL_GEOIP_ASN_PATH=./data/GeoLite2-ASN.mmdb


# ── TLS termination (optional) ─────────────────────────

# Static fallback cert/key (PEM). With both set, the HTTPS listener starts.
# Per-zone certificates pushed by the control plane override this via SNI.
# VEIL_TLS_CERT=./certs/fullchain.pem
# VEIL_TLS_KEY=./certs/privkey.pem


# ── Observability ──────────────────────────────────────

# Log level (trace, debug, info, warn, error)
VEIL_LOG_LEVEL=debug

# Analytics worker base URL for batched request-log forwarding ({url}/ingest).
# Unset disables emission.
# VEIL_ANALYTICS_URL=http://localhost:5001
