# ─────────────────────────────────────────────────────────────────────────
# Veil control plane — environment template
#
# Copy to `.env` and fill in. These map to the .NET configuration system via
# the double-underscore convention: `Section__Key` overrides `Section:Key`
# from appsettings.json. Values below are the production-shaped defaults;
# development uses the committed appsettings.Development.json instead.
#
# The Rust edge node has its own template: see edge/.env.example.
# ─────────────────────────────────────────────────────────────────────────


# ── Shared data stores ─────────────────────────────────────────────────────

# PostgreSQL — used by every control-plane service (Api, Analytics.Worker).
# Each module owns its own schema inside this one database.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=veil;Username=veil;Password=CHANGE_ME

# ClickHouse — request-log store (Analytics.Worker writes, Veil.Api reads).
ClickHouse__Url=http://localhost:8123
ClickHouse__Database=veil
ClickHouse__Username=veil
ClickHouse__Password=CHANGE_ME
# Days before request-log rows expire (ClickHouse TTL).
# ClickHouse__RetentionDays=30


# ── Veil.Api (control plane HTTP) ──────────────────────────────────────────

# Kestrel bind address. In containers use http://+:8080.
ASPNETCORE_URLS=http://localhost:5210
# ASPNETCORE_ENVIRONMENT=Production

# Auth — JWT issuance + validation.
# SigningKey: HMAC-SHA256 key, >= 32 chars of entropy. UNSET disables token
# issuance AND JWT validation (every endpoint becomes open) — always set it
# outside throwaway dev.
Auth__SigningKey=CHANGE_ME_AT_LEAST_32_CHARS_LONG
# Auth__Issuer=veil-control-plane
# Auth__Audience=veil
# Auth__AccessTokenMinutes=15
# Auth__RefreshTokenDays=14
# Login brute-force lockout: failures before lockout, and lockout duration.
# Auth__MaxFailedLoginAttempts=5
# Auth__LockoutMinutes=15
# Seed admin (created only when no users exist). If AdminPassword is unset a
# random one is generated and logged once at startup.
Auth__AdminEmail=admin@veil.local
Auth__AdminPassword=CHANGE_ME

# Obfuscation — Feistel seed for public ids. MUST be stable per environment:
# changing it changes every public id. Keep it secret and consistent.
Obfuscation__Seed=CHANGE_ME_STABLE_PER_ENVIRONMENT

# ConfigSync (hosted in Veil.Api) — pushes zone config to edge nodes.
# PushHmacKey: 64 hex chars (32 bytes), signs push bodies; must match each
# edge's VEIL_PUSH_HMAC_KEY. Unset disables config sync entirely.
ConfigSync__PushHmacKey=CHANGE_ME_64_HEX
# Header carrying the signature (must match edge VEIL_PUSH_SIGNATURE_HEADER).
# ConfigSync__SignatureHeader=X-Veil-Signature
# Edge push receiver path (must match the edge's reserved path).
# ConfigSync__PushPath=/_veil/internal/config
# Redis for leader election + backoff retry queue (multi-replica K8s). Unset →
# single-instance local coordination.
# ConfigSync__RedisConnection=localhost:6379

# Certificates — ACME provisioning + renewal worker (hosted in Veil.Api).
# EncryptionKey: AES-256-GCM key (64 hex chars) protecting private keys at
# rest. UNSET → the ACME worker is disabled (keys are never stored plaintext).
# Certificates__EncryptionKey=CHANGE_ME_64_HEX
# ACME v2 directory URL. UNSET → ACME worker disabled.
#   Let's Encrypt staging: https://acme-staging-v02.api.letsencrypt.org/directory
#   Let's Encrypt prod:    https://acme-v02.api.letsencrypt.org/directory
# Certificates__AcmeDirectoryUrl=
# Certificates__AcmeAccountEmail=ops@example.com
# Certificates__RenewBeforeDays=30
# Certificates__OrderTimeoutSeconds=60
# Accept the ACME directory's TLS cert without validation — DEV ONLY (Pebble).
# Certificates__AcmeAllowUntrustedTls=false


# ── Observability (both services) ──────────────────────────────────────────

# OpenTelemetry OTLP endpoint. Set to enable distributed tracing + metrics
# export (ASP.NET Core, HttpClient, runtime). Unset → telemetry disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317


# ── Veil.Analytics.Worker (log ingestion → ClickHouse) ─────────────────────

# Bind address for the ingestion endpoint (POST /ingest). The edge's
# VEIL_ANALYTICS_URL must point here.
# ASPNETCORE_URLS=http://localhost:5001
# Reuses ConnectionStrings__Default and the ClickHouse__* values above.

# SIEM export (optional). Mirror each request-log batch as NDJSON to a SIEM
# HTTP endpoint, fire-and-forget. Unset → disabled.
# Siem__Endpoint=https://siem.example.com/ingest
# Siem__ApiKeyHeader=Authorization
# Siem__ApiKey=Bearer CHANGE_ME
