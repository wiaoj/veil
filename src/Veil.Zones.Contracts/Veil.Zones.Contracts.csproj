<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tyto.Abstractions for IEvent/[Message]; the Wiaoj packages only
         satisfy the global usings injected by src/Directory.Build.props. -->
    <PackageReference Include="Tyto.Abstractions" Version="0.0.1-alpha.90" />
    <PackageReference Include="Wiaoj.Ddd.Abstractions" Version="0.0.1-alpha.75" />
    <PackageReference Include="Wiaoj.Primitives" Version="0.0.1-alpha.75" />
    <PackageReference Include="Wiaoj.Results" Version="0.0.1-alpha.75" />
  </ItemGroup>

</Project>
