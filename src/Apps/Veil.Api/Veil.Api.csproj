<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="3.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
    <PackageReference Include="Tyto" Version="0.0.1-alpha.91" />
    <PackageReference Include="Tyto.DependencyInjection" Version="0.0.1-alpha.91" />
    <PackageReference Include="Tyto.Transports.InMemory" Version="0.0.1-alpha.91" />
    <!-- Tyto RPC client (Phase 12): calls the analytics worker's incident feed. -->
    <PackageReference Include="Tyto.Rpc" Version="0.0.1-alpha.91" />
    <PackageReference Include="Tyto.Rpc.Client" Version="0.0.1-alpha.91" />
    <PackageReference Include="Tyto.Rpc.Http" Version="0.0.1-alpha.91" />
    <!-- RPC server: control plane serves AI rule application (Phase 12 Slice 2). -->
    <PackageReference Include="Tyto.Rpc.Server" Version="0.0.1-alpha.91" />
    <PackageReference Include="Tyto.Rpc.Hosting.AspNetCore" Version="0.0.1-alpha.91" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Veil.Analytics\Veil.Analytics.csproj" />
    <ProjectReference Include="..\..\Veil.Auth\Veil.Auth.csproj" />
    <ProjectReference Include="..\..\Veil.Certificates\Veil.Certificates.csproj" />
    <ProjectReference Include="..\..\Veil.EdgeNodes\Veil.EdgeNodes.csproj" />
    <ProjectReference Include="..\..\Veil.Infrastructure.Security\Veil.Infrastructure.Security.csproj" />
    <ProjectReference Include="..\..\Veil.Zones\Veil.Zones.csproj" />
  </ItemGroup>

</Project>
